{
  "name": "ionicformulacompetition-lite",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-07",
  "account_id": "57b6032a34645abf597e8662b0e70ede",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {"RELEASE_SHA": "development"},
  "durable_objects": {
    "bindings": [{"name": "ROOMS", "class_name": "LiteRoom"}]
  },
  "migrations": [{"tag": "lite-v1", "new_sqlite_classes": ["LiteRoom"]}]
}
